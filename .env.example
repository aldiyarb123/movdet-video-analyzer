# Copy to .env and fill in. Never commit .env.
# All values below are placeholders.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql://user:password@localhost:5432/motionscope
REDIS_URL=redis://localhost:6379/0

STORAGE_DIR=./data
MAX_UPLOAD_MB=500

# Model settings
DETECTOR_MODEL=yolo-nano-placeholder
TRACKER=bytetrack
CONFIDENCE_THRESHOLD=0.35

SECRET_KEY=change-me
