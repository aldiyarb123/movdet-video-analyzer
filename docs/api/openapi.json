{
  "openapi": "3.1.0",
  "info": {
    "title": "MotionScope API",
    "description": "Upload a video, run moving-object analysis as a job, read tracks and exports.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "description": "History, newest first.",
        "operationId": "list_jobs_api_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "description": "FR-01, FR-02: upload a video with settings; returns the queued job.",
        "operationId": "create_job_api_jobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_job_api_jobs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "413": {
            "description": "File too large"
          },
          "415": {
            "description": "Unsupported file type"
          },
          "422": {
            "description": "Invalid settings or unreadable video"
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job Status",
        "description": "FR-03: status and progress (0..1).",
        "operationId": "job_status_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "Delete Job",
        "operationId": "delete_job_api_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/events": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job Events",
        "description": "FR-03: Server-Sent Events with the job on every change, until it finishes.",
        "operationId": "job_events_api_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel Job",
        "operationId": "cancel_job_api_jobs__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/video": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Job Video",
        "operationId": "job_video_api_jobs__job_id__video_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/tracks": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Job Tracks",
        "description": "Tracks with boxes per frame ([frame, x, y, w, h]) for the overlay (FR-09).",
        "operationId": "job_tracks_api_jobs__job_id__tracks_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "moving_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Moving Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TracksResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/report.json": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Report Json",
        "description": "FR-11: report in the schema docs/schemas/export-report.schema.json.",
        "operationId": "report_json_api_jobs__job_id__report_json_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Report Json Api Jobs  Job Id  Report Json Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/report.csv": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Report Csv",
        "operationId": "report_csv_api_jobs__job_id__report_csv_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/tracks/{track_id}/crop": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Track Crop",
        "description": "FR-07: one of the saved crops of a moving track.",
        "operationId": "track_crop_api_jobs__job_id__tracks__track_id__crop_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "track_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Track Id"
            }
          },
          {
            "name": "index",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Index"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/tracks/{track_id}/clip": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Track Clip",
        "description": "FR-08: the saved clip of a moving track.",
        "operationId": "track_clip_api_jobs__job_id__tracks__track_id__clip_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "track_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Track Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisSettings": {
        "properties": {
          "classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 80,
            "minItems": 1,
            "title": "Classes"
          },
          "confidence": {
            "type": "number",
            "maximum": 0.95,
            "minimum": 0.05,
            "title": "Confidence",
            "default": 0.35
          },
          "tracker": {
            "type": "string",
            "enum": [
              "bytetrack",
              "botsort"
            ],
            "title": "Tracker",
            "default": "bytetrack"
          },
          "backend": {
            "type": "string",
            "enum": [
              "yolo",
              "mog2"
            ],
            "title": "Backend",
            "description": "yolo = main pipeline, mog2 = baseline B0",
            "default": "yolo"
          },
          "motion": {
            "$ref": "#/components/schemas/MotionSettings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalysisSettings",
        "description": "FR-02: analysis settings. Omitted fields get defaults; out-of-range values are rejected."
      },
      "Body_create_job_api_jobs_post": {
        "properties": {
          "video": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Video"
          },
          "settings": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settings"
          }
        },
        "type": "object",
        "required": [
          "video"
        ],
        "title": "Body_create_job_api_jobs_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "processor": {
            "type": "string",
            "title": "Processor"
          }
        },
        "type": "object",
        "required": [
          "processor"
        ],
        "title": "Health"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "description": "0..1, never decreases",
            "default": 0.0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "settings": {
            "$ref": "#/components/schemas/AnalysisSettings"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "filename",
          "size_bytes",
          "created_at",
          "updated_at",
          "settings"
        ],
        "title": "Job"
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "type": "array",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "jobs"
        ],
        "title": "JobList"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus"
      },
      "JobSummary": {
        "properties": {
          "frames": {
            "type": "integer",
            "title": "Frames"
          },
          "fps": {
            "type": "number",
            "title": "Fps"
          },
          "tracks_total": {
            "type": "integer",
            "title": "Tracks Total"
          },
          "tracks_moving": {
            "type": "integer",
            "title": "Tracks Moving"
          }
        },
        "type": "object",
        "required": [
          "frames",
          "fps",
          "tracks_total",
          "tracks_moving"
        ],
        "title": "JobSummary"
      },
      "MotionSettings": {
        "properties": {
          "min_displacement_px": {
            "type": "number",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Min Displacement Px",
            "default": 25.0
          },
          "window_frames": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Window Frames",
            "default": 15
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MotionSettings",
        "description": "ADR-0003: moving = centre travels at least `min_displacement_px` within `window_frames`."
      },
      "Track": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "class": {
            "type": "string",
            "title": "Class"
          },
          "first_frame": {
            "type": "integer",
            "title": "First Frame"
          },
          "last_frame": {
            "type": "integer",
            "title": "Last Frame"
          },
          "moving": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Moving"
          },
          "displacement_px": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displacement Px"
          },
          "boxes": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Boxes",
            "description": "[frame, x, y, w, h] per observation"
          }
        },
        "type": "object",
        "required": [
          "id",
          "class",
          "first_frame",
          "last_frame",
          "boxes"
        ],
        "title": "Track"
      },
      "TracksResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "fps": {
            "type": "number",
            "title": "Fps"
          },
          "frames": {
            "type": "integer",
            "title": "Frames"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/Track"
            },
            "type": "array",
            "title": "Tracks"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "fps",
          "frames",
          "width",
          "height",
          "tracks"
        ],
        "title": "TracksResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
